# Copy this file to .env and fill in real values. Never commit or email .env.
# ---- Database passwords: one line per password_env name in recon_config.yaml
DWH_PWD=change_me
MIS_PWD=change_me
RECON_PWD=change_me

# ---- Web app logins (app.py). Format  name:password,name:password  (no commas in passwords)
# Can view results AND start/stop runs:
UI_USERS=yourname:change_me
# Can only view results (optional):
# UI_VIEWERS=manager:change_me
